# Database URL for PostgreSQL
DATABASE_URL="postgresql://username:password@localhost:5432/mydb"

# Better Auth configuration
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-random-32-byte-secret"

# Admin Login & Password (.env orqali boshqariladi)
ADMIN_LOGIN="admin@mobilefix.uz"
ADMIN_PASSWORD="password123"

# Telegram Bot (grammY -> Elysia Webhook -> TanStack API)
BOT_TOKEN="123456789:ABCDEF_your_telegram_bot_token_here"
WEBHOOK_SECRET="replace-with-telegram-webhook-secret"

# App Features Control (Comma-separated array or "all")
# Core modules: repairs,phones,parts,pos,sales,debts,customers,analytics (or warehouse alias for phones,parts)
# Add-on features: trade_in,export,dynamic_fields,telegram_bot,currency_rates,thermal_print
# Example (all enabled): APP_FEATURES="all"
# Example (partial): APP_FEATURES="repairs,phones,parts,pos,sales,debts,customers"
APP_FEATURES="all"

# App Live Demo Time Limit (in hours).
# Leave empty ("") for unlimited runtime (no countdown badge shown).
# Set to a number in hours (e.g. "24" or "2") to show a live countdown in the UI
# and automatically lock the app + API after N hours from server start.
APP_LIVE_HOURS=""
# Optional ISO timestamp override for when the N-hour window started (defaults to server start time):
# APP_LIVE_START_TIME="2026-11-03T12:00:00Z"
